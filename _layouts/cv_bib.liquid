<div class="cvx-item">
  <div class="cvx-date">{{ entry.cvlabel }}<br>{{ entry.year }}</div>
  <div>
    <div class="cvx-title">{{ entry.title }}</div>
    <div class="cvx-detail">
      {%- assign n = entry.author_array | size -%}
      {%- for author in entry.author_array -%}
        {%- if forloop.last and n > 1 -%}and {% endif -%}
        {%- assign full = author.first | append: ' ' | append: author.last -%}
        {%- if author.last == 'Zhao' and author.first contains 'Guangxin' -%}
          <strong>{{ full }}</strong>
        {%- else -%}
          {{ full }}
        {%- endif -%}
        {%- unless forloop.last -%}{% if n > 2 %}, {% else %} {% endif %}{%- endunless -%}
      {%- endfor -%}
    </div>
    <div class="cvx-detail">
      <em>
        {%- if entry.type == 'article' -%}
          {{ entry.journal }}{% if entry.volume %}, {{ entry.volume }}{% if entry.number %}({{ entry.number }}){% endif %}{% endif %}{% if entry.pages %}, {{ entry.pages | replace: '--', '–' }}{% endif %}
        {%- elsif entry.type == 'inproceedings' -%}
          {{ entry.booktitle }}{% if entry.pages %}, pp. {{ entry.pages | replace: '--', '–' }}{% endif %}
        {%- else -%}
          {{ entry.howpublished }}
        {%- endif -%}
      </em>
    </div>
    <div class="cvx-links-inline">
      {%- if entry.pdf %}<a href="{{ entry.pdf }}" target="_blank" rel="external nofollow noopener">PDF</a>{% endif -%}
      {%- if entry.doi %}<a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="external nofollow noopener">DOI</a>{% endif -%}
      {%- if entry.code %}<a href="{{ entry.code }}" target="_blank" rel="external nofollow noopener">Code</a>{% endif -%}
    </div>
  </div>
</div>
